// NoemaBoard relay on Cloudflare (Workers free plan). Deploy with `npx wrangler deploy`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "noema-relay",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RelayRoom" },
      { "name": "BLOBS", "class_name": "BlobStore" }
    ]
  },
  // SQLite-backed Durable Objects are available on the free plan.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RelayRoom", "BlobStore"] }],
  "vars": {
    // Largest single file in MB. Free-plan request bodies are limited to 100 MB.
    "MAX_BLOB_MB": "25",
    // Storage quota per board (updates + snapshots, and separately files) in MB.
    "MAX_ROOM_MB": "512",
    // Largest single sync message in MB. Announced to the app, which splits bigger changes; a board
    // snapshot is one message. Keep it well below the 128 MB Durable Object memory limit.
    "MAX_MESSAGE_MB": "16"
  },
  // Optional: require an access key from every client: `npx wrangler secret put ACCESS_KEY`
  // Off on purpose: nothing optional that could ever count toward usage.
  "observability": { "enabled": false }
}
