{
  "name": "noema",
  "productName": "NoemaBoard",
  "version": "0.1.2",
  "description": "Free, open-source visual boards for teams. Real-time, end-to-end encrypted collaboration with no accounts and no limits.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "out/main/index.cjs",
  "homepage": "https://noemaboard.app",
  "author": {
    "name": "NoemaBoard contributors",
    "email": "noreply@example.com"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop": "electron-vite dev",
    "build:web": "tsc -b && vite build",
    "build:desktop": "electron-vite build",
    "preview": "vite preview",
    "preview:desktop": "electron-vite preview",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "icons": "electron build/make-icons.cjs",
    "typecheck": "tsc -b && tsc -p electron/tsconfig.json",
    "test": "vitest run",
    "lint": "oxlint src electron",
    "postinstall": "install-electron",
    "build:cloudflare": "vite build --mode cloudflare",
    "deploy:cloudflare": "node scripts/build-site.mjs && cd relay/cloudflare && npx wrangler deploy -c wrangler.app.jsonc",
    "build:site": "node scripts/build-site.mjs",
    "screenshots": "electron scripts/capture-screens.cjs"
  },
  "dependencies": {
    "@floating-ui/react": "0.27.20",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-collaboration": "3.32.0",
    "@tiptap/extension-collaboration-caret": "3.32.0",
    "@tiptap/extension-color": "3.32.0",
    "@tiptap/extension-highlight": "3.32.0",
    "@tiptap/extension-link": "3.32.0",
    "@tiptap/extension-list": "3.32.0",
    "@tiptap/extension-placeholder": "3.32.0",
    "@tiptap/extension-text-align": "3.32.0",
    "@tiptap/extension-text-style": "3.32.0",
    "@tiptap/extension-typography": "3.32.0",
    "@tiptap/extensions": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/y-tiptap": "^3.0.7",
    "@trystero-p2p/torrent": "0.26.0",
    "electron-updater": "6.8.11",
    "fflate": "^0.8.3",
    "fractional-indexing": "^4.0.0",
    "htmlparser2": "12.0.0",
    "idb": "^8.0.4",
    "lib0": "0.2.119",
    "lucide-react": "^1.61.0",
    "nanoid": "^6.0.2",
    "perfect-freehand": "^1.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "trystero": "^0.26.0",
    "y-indexeddb": "^9.0.12",
    "y-protocols": "^1.0.7",
    "yjs": "13.6.33",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.3",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "fake-indexeddb": "^6.0.0",
    "oxlint": "^1.89.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "yjs": "13.6.33",
    "lib0": "0.2.119"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobertRigopoulos/noemaboard.git"
  },
  "bugs": {
    "url": "https://github.com/RobertRigopoulos/noemaboard/issues"
  }
}
